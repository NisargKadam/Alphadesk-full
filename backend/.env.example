OPENAI_API_KEY=sk-proj-your-key-here
# ⚠️ PLACEHOLDER — instructor confirms model before class:
OPENAI_MODEL=gpt-4.1-mini
# Session 04: set to false to answer straight from the top-k retrieved chunks
RERANK_ENABLED=true

# Session 09: ship traces + eval experiments to a locally hosted Opik
# (https://github.com/comet-ml/opik). The SDK reads ~/.opik.config for the
# server URL; with tracing off, nothing changes.
OPIK_TRACING=false
OPIK_PROJECT_NAME=alphadesk
